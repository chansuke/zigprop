.{
    .name = .zigprop,
    .version = "0.3.0",
    // Together with name, this represents a globally unique package
    // identifier. Generated by the Zig toolchain; it never changes.
    .fingerprint = 0x5fb7bf2200be48db, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    // Everything build.zig declares a step for, plus the docs and the
    // license. A listed directory includes all files within it.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "bench",
        "validation",
        "tools",
        "docs",
        "LICENSE",
        "README.md",
    },
}
